# Viewesta web app (Create React App).
# Copy to .env:  cp .env.example .env
# Only variables starting with REACT_APP_ are read, and only when the dev server
# starts or a build runs — restart `npm start` after editing.

# ── Backend API ───────────────────────────────────────────────────────────────
# Host only: the app adds /api/<REACT_APP_API_VERSION> itself.
REACT_APP_API_BASE=
REACT_APP_API_VERSION=v1

# ── Firebase (push notifications) ─────────────────────────────────────────────
# Public web config of the "viewesta" Firebase project (it ships in the browser
# bundle, so it isn't secret). Firebase console → Project settings → Your apps.
REACT_APP_FIREBASE_API_KEY=
REACT_APP_FIREBASE_AUTH_DOMAIN=
REACT_APP_FIREBASE_PROJECT_ID=
REACT_APP_FIREBASE_STORAGE_BUCKET=
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=
REACT_APP_FIREBASE_APP_ID=
# Cloud Messaging → Web Push certificates → public key pair.
REACT_APP_FIREBASE_VAPID_KEY=
